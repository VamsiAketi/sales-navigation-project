DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HELO_HOST=localhost
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Microsoft Entra / Azure AD sign-in (authenticated mode). Tenant ID is optional (defaults to multi-tenant "common").
# AI_HARNESS_AUTH_MICROSOFT_TENANT_ID=
# AI_HARNESS_AUTH_MICROSOFT_CLIENT_ID=
# AI_HARNESS_AUTH_MICROSOFT_CLIENT_SECRET=
#
# Optional: when a user signs in with Microsoft but has no company membership yet, add them automatically:
# PAPERCLIP_AUTH_MICROSOFT_AUTO_PROVISION_COMPANY_ID=<uuid>   # or use COMPANY_IDS for multiple
# PAPERCLIP_AUTH_MICROSOFT_AUTO_PROVISION_COMPANY_IDS=<uuid>,<uuid>
# PAPERCLIP_AUTH_MICROSOFT_AUTO_PROVISION_MEMBERSHIP_ROLE=member
# Optional allowlist (comma-separated domains, no @): only these email domains get auto-provisioned
# PAPERCLIP_AUTH_MICROSOFT_AUTO_PROVISION_EMAIL_DOMAINS=contoso.com,fabrikam.com

# Stripe (optional). Use a test secret key from Dashboard → Developers → API keys (Test mode).
# No real money moves in test mode; use test cards (e.g. 4242424242424242) and Stripe’s test data.
# PAPERCLIP_STRIPE_SECRET_KEY=sk_test_...
# (alias) STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret from Developers → Webhooks.
# PAPERCLIP_STRIPE_WEBHOOK_SECRET=whsec_...
# (alias) STRIPE_WEBHOOK_SECRET=whsec_...
