{

  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "corepack enable && pnpm install --filter @paperclipai/ui... --frozen-lockfile",

  "buildCommand": "cd \"$(git rev-parse --show-toplevel)\" && node scripts/vercel-build.mjs",

  "outputDirectory": "vercel-static",

  "framework": null,

  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]

}


